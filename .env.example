# samickh — 환경변수 예시. 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# .env 와 로컬 DB(prisma/dev.db)는 .gitignore 대상 — 절대 커밋하지 않습니다.

# 사이트 절대 URL (OG·canonical·sitemap 기준). 미설정 시 http://localhost:5700
NEXT_PUBLIC_SITE_URL=https://www.example.com

# 관리자 인증 — scrypt 해시. 포맷 "saltHex.hashHex"(점 구분 — `$` 문자 금지: .env 절단 함정).
#   node scripts/admin-hash.mjs '<원하는 비밀번호>' 로 생성
ADMIN_PASSWORD_HASH=
# 세션 서명용 랜덤 시크릿 (openssl rand -hex 32) — 미설정 시 로그인 불가(fail-closed)
ADMIN_SESSION_SECRET=

# 리버스 프록시 뒤에서의 클라 IP 판정(x-forwarded-for에서 뒤에서 N번째). 기본 1
TRUSTED_PROXY_HOPS=1

# (선택) 문의/견적 접수 SMTP 알림 — SMTP_HOST·INQUIRY_NOTIFY_TO 미설정 시 알림 기능 무동작(에러 없음)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
INQUIRY_NOTIFY_TO=

# (선택) 콘텐츠 작업용 — 이미지 생성·번역. 런타임 구동엔 불필요.
# ⚠️ NEXT_PUBLIC_* 과 같은 줄에 붙이지 말 것(공개 변수로 키가 새어 렌더 HTML에 노출됨).
OPENAI_API_KEY=
